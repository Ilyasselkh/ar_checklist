<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_analysis_search" model="ir.ui.view">
  <field name="name">ar.checklist.analysis.search</field><field name="model">ar.checklist</field>
  <field name="arch" type="xml"><search>
   <field name="equipe"/><field name="chef_id"/><field name="date"/>
   <filter name="period" string="Période" date="date"/>
   <group><filter name="shift" string="Shift" context="{'group_by': 'equipe'}"/>
   <filter name="day" string="Jour" context="{'group_by': 'date:day'}"/>
   <filter name="month" string="Mois" context="{'group_by': 'date:month'}"/>
   <filter name="chef" string="Opérateur polyvalent" context="{'group_by': 'chef_id'}"/></group>
  </search></field>
 </record>
<record id="view_analysis_staff_graph" model="ir.ui.view"><field name="name">ar.checklist.analysis.staff.graph</field><field name="model">ar.checklist</field><field name="arch" type="xml"><graph string="Effectifs" type="bar"><field name="equipe" type="row"/><field name="date" interval="month" type="row"/><field name="analysis_staff_total" type="measure"/><field name="analysis_available" type="measure"/><field name="analysis_unavailable" type="measure"/><field name="nb_absents" type="measure"/></graph></field></record>
<record id="view_analysis_staff_pivot" model="ir.ui.view"><field name="name">ar.checklist.analysis.staff.pivot</field><field name="model">ar.checklist</field><field name="arch" type="xml"><pivot string="Effectifs"><field name="equipe" type="row"/><field name="date" interval="month" type="col"/><field name="analysis_staff_total" type="measure"/><field name="analysis_available" type="measure"/><field name="analysis_unavailable" type="measure"/><field name="nb_absents" type="measure"/></pivot></field></record>
<record id="action_analysis_staff" model="ir.actions.act_window"><field name="name">Effectifs</field><field name="res_model">ar.checklist</field><field name="view_mode">graph,pivot,list,form</field><field name="search_view_id" ref="view_analysis_search"/><field name="domain">[('active', '=', False), ('workflow_state', '=', 'archive'), ('supervisor_decision', '!=', 'refused')]</field><field name="context">{'active_test': False}</field></record>
<record id="action_analysis_staff_graph" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">graph</field><field name="view_id" ref="view_analysis_staff_graph"/><field name="act_window_id" ref="action_analysis_staff"/></record>
<record id="action_analysis_staff_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_analysis_staff_pivot"/><field name="act_window_id" ref="action_analysis_staff"/></record>
<record id="view_analysis_activity_graph" model="ir.ui.view"><field name="name">ar.checklist.analysis.activity.graph</field><field name="model">ar.checklist</field><field name="arch" type="xml"><graph string="Activité (palettes)" type="bar"><field name="equipe" type="row"/><field name="date" interval="month" type="row"/><field name="total_prep_manuf" type="measure"/><field name="total_prep_trad" type="measure"/><field name="total_exp_manuf" type="measure"/><field name="total_exp_trad" type="measure"/><field name="total_alim_tri" type="measure"/><field name="total_dechargement" type="measure"/></graph></field></record>
<record id="view_analysis_activity_pivot" model="ir.ui.view"><field name="name">ar.checklist.analysis.activity.pivot</field><field name="model">ar.checklist</field><field name="arch" type="xml"><pivot string="Activité (palettes)"><field name="equipe" type="row"/><field name="date" interval="month" type="col"/><field name="total_prep_manuf" type="measure"/><field name="total_prep_trad" type="measure"/><field name="total_exp_manuf" type="measure"/><field name="total_exp_trad" type="measure"/><field name="total_alim_tri" type="measure"/><field name="total_dechargement" type="measure"/></pivot></field></record>
<record id="action_analysis_activity" model="ir.actions.act_window"><field name="name">Activité (palettes)</field><field name="res_model">ar.checklist</field><field name="view_mode">graph,pivot,list,form</field><field name="search_view_id" ref="view_analysis_search"/><field name="domain">[('active', '=', False), ('workflow_state', '=', 'archive'), ('supervisor_decision', '!=', 'refused')]</field><field name="context">{'active_test': False}</field></record>
<record id="action_analysis_activity_graph" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">graph</field><field name="view_id" ref="view_analysis_activity_graph"/><field name="act_window_id" ref="action_analysis_activity"/></record>
<record id="action_analysis_activity_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_analysis_activity_pivot"/><field name="act_window_id" ref="action_analysis_activity"/></record>
<record id="view_analysis_prolongement_graph" model="ir.ui.view"><field name="name">ar.checklist.analysis.prolongement.graph</field><field name="model">ar.checklist</field><field name="arch" type="xml"><graph string="Prolongement (Carton/Qte)" type="bar"><field name="equipe" type="row"/><field name="date" interval="month" type="row"/><field name="total_prolongement" type="measure"/></graph></field></record>
<record id="view_analysis_prolongement_pivot" model="ir.ui.view"><field name="name">ar.checklist.analysis.prolongement.pivot</field><field name="model">ar.checklist</field><field name="arch" type="xml"><pivot string="Prolongement (Carton/Qte)"><field name="equipe" type="row"/><field name="date" interval="month" type="col"/><field name="total_prolongement" type="measure"/></pivot></field></record>
<record id="action_analysis_prolongement" model="ir.actions.act_window"><field name="name">Prolongement (Carton/Qte)</field><field name="res_model">ar.checklist</field><field name="view_mode">graph,pivot,list,form</field><field name="search_view_id" ref="view_analysis_search"/><field name="domain">[('active', '=', False), ('workflow_state', '=', 'archive'), ('supervisor_decision', '!=', 'refused')]</field><field name="context">{'active_test': False}</field></record>
<record id="action_analysis_prolongement_graph" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">graph</field><field name="view_id" ref="view_analysis_prolongement_graph"/><field name="act_window_id" ref="action_analysis_prolongement"/></record>
<record id="action_analysis_prolongement_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_analysis_prolongement_pivot"/><field name="act_window_id" ref="action_analysis_prolongement"/></record>
<record id="action_checklist_dashboard" model="ir.actions.client"><field name="name">Tableau de bord</field><field name="tag">ar_checklist.dashboard</field></record>
</odoo>
